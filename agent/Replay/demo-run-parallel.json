    {
      "text": "Sarah: intermediate, strength, 3 days, mild left shoulder. I'm handing week 1 to three day-builders and an injury screen, all at once.",
      "calls": [
        {
          "callId": "par-2",
          "name": "runSubagents",
          "arguments": {
            "clientId": "sarah",
            "goal": "strength",
            "daysPerWeek": 3,
            "tasks": [
              {
                "kind": "build-day",
                "week": 1,
                "day": "Mon",
                "focus": "Lower",
                "brief": "Squat-led lower day: back squat as the main lift, then a hinge, single-leg work and core."
              },
              {
                "kind": "build-day",
                "week": 1,
                "day": "Wed",
                "focus": "Upper",
                "brief": "Upper day for a strength block. She wants overhead press, so make it the main lift; rows and face pulls for balance."
              },
              {
                "kind": "build-day",
                "week": 1,
                "day": "Fri",
                "focus": "Full body",
                "brief": "Trap-bar deadlift as the main lift, then a medium-stress press, a vertical pull and a carry."
              },
              {
                "kind": "injury-screen",
                "brief": "Left shoulder is sore under overhead load. Which strength-block lifts are risky for her, and what are the safer swaps?"
              }
            ]
          }
        }
      ],
      "delayMs": 700
    },
    {
      "text": "Week 1 is in. Wednesday's builder used the overhead press, which is high shoulder stress for Sarah, so I've flagged it. Your call:",
      "calls": [
        {
          "callId": "par-3",
          "name": "updateProgram",
          "arguments": {
            "flags": [
              {
                "exerciseId": "overhead-press",
                "reason": "left shoulder"
              }
            ]
          }
        },
        {
          "callId": "par-4",
          "name": "proposeSwap",
          "arguments": {
            "fromExerciseId": "overhead-press",
            "toExerciseId": "landmine-press",
            "reason": "High shoulder stress on a sore left shoulder. The landmine press keeps the pressing pattern at medium stress."
          }
        }
      ],
      "delayMs": 600
    },
